# Auto-detect text files and ensure they use LF line endings
* text=auto eol=lf

# Notebooks - treat as Python for language stats
*.ipynb text diff=ipynb
*.ipynb linguist-language=Python

# Uncomment if using Git LFS:
# data/raw/*.csv filter=lfs diff=lfs merge=lfs -text
